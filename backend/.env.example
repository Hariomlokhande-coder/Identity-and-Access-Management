# Copy to .env and fill in for non-local environments. Never commit real secrets.
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

DB_URL=jdbc:postgresql://postgres:5432/iam
DB_USERNAME=iam
DB_PASSWORD=change-me

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me

IAM_ISSUER=https://auth.example.com
IAM_LOGIN_URL=https://app.example.com/login
IAM_CONSENT_URL=https://app.example.com/consent
IAM_CORS_ORIGINS=https://app.example.com
IAM_COOKIE_DOMAIN=.example.com

# JSON array of signing keys. Exactly one entry should have "active": true.
# Generate with: ./scripts/generate-jwt-key.sh my-kid-2026-01
IAM_JWT_KEYS=[{"kid":"k1","active":true,"privateKey":"MIIEv...","publicKey":"MIIBIj..."}]

MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=change-me
MAIL_SMTP_AUTH=true
MAIL_SMTP_TLS=true
IAM_MAIL_FROM=no-reply@example.com
